    "feedback.content.placeholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What happened and what you'd like — the more specific, the better"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇到了什么、希望怎样，越具体越好"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇到了什麼、希望怎樣，越具體越好"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何が起きたか、どうしてほしいか。具体的なほど助かります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 일이 있었고 어떻게 되길 바라는지, 구체적일수록 좋아요"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist passiert und was wünschst du dir? Je genauer, desto besser"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui s'est passé et ce que vous souhaitez : plus c'est précis, mieux c'est"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué pasó y qué te gustaría; cuanto más concreto, mejor"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa è successo e cosa vorresti: più dettagli, meglio è"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que aconteceu e o que você gostaria — quanto mais específico, melhor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что случилось и чего бы вы хотели — чем конкретнее, тем лучше"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat gebeurde er en wat zou je willen? Hoe concreter, hoe beter"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad hände och vad önskar du? Ju mer konkret, desto bättre"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co się stało i czego oczekujesz? Im konkretniej, tym lepiej"
