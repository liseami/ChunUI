        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne oldu ve ne istersiniz? Ne kadar ayrıntılı, o kadar iyi"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماذا حدث وما الذي تتمناه — كلما كان أدق كان أفضل"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
